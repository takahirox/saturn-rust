# Original MIT benchmark guest. Reset vectors: PC=00000200, SP=060FF000.
# Enable SH-2 cache, then increment R0 and store it to 06020000 forever.
# 0200: MOV.L CCR,R1; MOV #1,R0; MOV.B R0,@R1; MOV.L result,R1
# 0208: MOV #0,R0; ADD #1,R0; MOV.L R0,@R1; BRA 020A; NOP
00000000 0000 0200 060F F000
00000200 D107 E001 2100 D107 E000 7001 2102 AFFC 0009
00000220 FFFF FE92 0602 0000
