# Original synthetic SH-2 BIOS, MIT licensed (see adjacent LICENSE).
# Offset followed by big-endian words; unspecified bytes are zero.
# Reset PC/SP, CPU address-error vector 9.
0000 0000 0100 0610 0000
0024 0000 0200
# Main: load trace pointer and invalid operand address; MOV #85,R2;
# MOV.L @R1+,R6 (error, auto increment); BRA to 0112;
# MOV.W R2,@-R1 (error in slot, auto decrement); skipped instructions;
# load odd target; JMP; ADD #1,R4 (slot); skipped instruction;
# odd fetch at 011B (handler advances stacked PC); ADD #7,R5; SLEEP.
0100 D81F D120 E255 6616 A003 2125 E363 0009 0009 D31D 432B 7401 E563 0009 7507 001B
# Trace address, invalid operand address, odd jump target.
0180 0600 2000 0600 1001 0000 011B
# Handler logs stacked PC and SR using only guest instructions. Increments R9.
# If saved PC is odd, increments it in the exception stack before RTE.
0200 6AF2 28A2 7804 5AF1 28A2 7804 7901 6AF2 60A3 C901 8800 8901 7A01 2FA2 002B 0009
