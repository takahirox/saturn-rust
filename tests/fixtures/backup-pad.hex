# Original SH-2 backup/direct-port diagnostic, MIT: see LICENSE.
# Power-on PC/SP. No Sega firmware; this is a test ROM, not a disc.
00000000 0000 0100 0610 0000
# R1=backup byte address. Increment and store through real MOV.B instructions.
# R2=PDR2. Set DDR2=60, IOSEL2=1, EXLE2=0, TH/TR=01; read directions.
# Wait 32 iterations for pad settling. R4=work RAM diagnostic:
# store the PDR2 selection in +0 and the active-low pad report in +4.
# Poll the pad in a bounded guest loop. The host only supplies button levels.
00000100 D10F 6010 7001 2100 D20E E060 8024 E002
00000110 8026 E000 8028 E020 2200 E620 4610 8BFD
00000120 6320 D40A 2402 1431 AFFA 0009
00000140 2018 0001 2010 0077
0000014C 0600 1000
