# Original synthetic SH7604 FRT guest, MIT licensed (adjacent LICENSE).
# Source-authored big-endian opcodes; unspecified bytes are zero.
# SH7604 §§11.4.3/11.4.6, figs. 11.7/11.11: compare on leaving N.
# Reset PC/SP and output-compare vector 32.
0000 0000 0100 0610 0000
0080 0000 0200
# MOV.L TCR,R1; MOV #3,R0; MOV.B R0,@R1 (freeze clock).
# MOV.L FRC,R1; MOV #0,R0; MOV.B R0,@R1; ADD #1,R1; MOV.B R0,@R1.
0100 D11F E003 2100 D11F E000 2100 7101 2100
# MOV.L OCRA,R1; MOV.B R0,@R1; MOV #3,R0; ADD #1,R1; MOV.B R0,@R1.
# Tests also replace the immediate at 0114 with MOV #0,R0 (OCRA=0).
# MOV.L FTCSR,R1; MOV #1,R0; MOV.B R0,@R1 (CCLRA).
0110 D11D 2100 E003 7101 2100 D11C E001 2100
# MOV.L TIER,R1; MOV #9,R0; MOV.B R0,@R1 (OCIAE).
# MOV.L IPRB,R1; MOV.L priority,R0; MOV.W R0,@R1.
# MOV.L VCRC,R1; MOV #32,R0; MOV.W R0,@R1.
0120 D11B E009 2100 D11B D01B 2101 D11B E020 2101
# MOV.L TCR,R1; MOV #2,R2; MOV #0,R0; LDC R0,SR; NOP.
# MOV.B R2,@R1 at 013C starts phi/128 with divider phase zero.
# SLEEP; SLEEP; BRA back to second SLEEP; NOP.
0132 D113 E202 E000 400E 0009 2120 001B 001B AFFD 0009
# Literals: TCR, FRC, OCRA, FTCSR, TIER, IPRB, priority, VCRC.
0180 FFFF FE16 FFFF FE12 FFFF FE14 FFFF FE11
0190 FFFF FE10 FFFF FE60 0000 0500 FFFF FE66
# Handler freezes timer, reads FTCSR, stores flags in shared RAM, acknowledges
# by read/zero-write while retaining CCLRA, then RTE; NOP.
0200 D11F E003 2100 D11F 6010 D21F 2202 E001 2100 002B 0009
0280 FFFF FE16 FFFF FE11 0600 2000
